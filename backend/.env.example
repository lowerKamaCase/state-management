# Neon: pooled connection (has "-pooler" in the hostname) — used by the running app
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require"
# Neon: direct/unpooled connection — used only by `prisma migrate deploy`/`prisma db seed`
DIRECT_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require"
PORT=3000
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176
